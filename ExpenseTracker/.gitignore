# Ignore Visual Studio temporary files, build results, and files generated by popular Visual Studio add-ons.
.vs/
.vscode/

# Ignore build outputs (compiled files)
bin/
obj/

# Ignore user-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Ignore Visual Studio project files that are regenerated
*.csproj.user

# Ignore solution-specific files
*.sln.docstates

# Ignore database files (if any)
*.mdf
*.ldf
*.sqlite
*.db

# Ignore logs
*.log

# Ignore temporary files created by text editors (like vim, etc.)
*.swp
*.bak

# Ignore macOS-specific files
.DS_Store

# Ignore JetBrains Rider project files (if applicable)
.idea/

# Ignore NuGet files
*.nupkg
*.snupkg
